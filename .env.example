# Fulgoria — server fino. El documento se procesa 100% en el navegador y NUNCA llega acá.
# Copiá este archivo a .env y completá los valores. El .env NO va al repo.

PORT=3000

# --- Login ---
# AUTH_ENABLED=false → la app se sirve sin clave (uso local / red privada).
AUTH_ENABLED=true
AUTH_USER=diego

# Tu contraseña, en texto plano (como Escriba/Fisherboy).
# Opcional, más seguro si el .env se filtra: un hash bcrypt en vez del texto plano.
#   node server.js --hash 'tu-contraseña'   ← y pegás el $2a$... acá
AUTH_PASSWORD=

# Secreto para firmar la cookie de sesión. Generalo con:
#   openssl rand -hex 32
SESSION_SECRET=

# Duración de la sesión, en horas.
SESSION_TTL_HOURS=12

# Cookie Secure: true detrás de HTTPS (EasyPanel). Poné false solo para probar local por http://.
COOKIE_SECURE=true

# --- Identidad: login propio (default) o federado con Lockatus (el hub de la suite) ---
# AUTH_MODE=local (default) → usa el login de arriba (AUTH_USER/AUTH_PASSWORD). NADA cambia.
# AUTH_MODE=federado → el login lo maneja Lockatus (SSO + 2FA + roles desde la matriz). En ese
#   modo NO hace falta AUTH_USER/AUTH_PASSWORD; sí SESSION_SECRET y las 3 vars de abajo. Antes de
#   usarlo: registrá el redirect_uri (LOCKATUS_REDIRECT_URI) y dale rol a los usuarios en Lockatus.
AUTH_MODE=local
LOCKATUS_ISSUER=
# Roles en federado: Lockatus manda el rol; los de Fulgoria son lector, preparador, revisor y admin.
# Si en Lockatus se llaman distinto, traducilos (un rol desconocido entra como lector):
#   LOCKATUS_ROLES=contador=preparador,socio=revisor,sistemas=admin
LOCKATUS_ROLES=
# Slug de esta app en Lockatus (su catálogo de roles). Para Fulgoria: "fulgoria".
LOCKATUS_CLIENT_ID=fulgoria
# A dónde vuelve Lockatus tras el login. Debe coincidir EXACTO con lo registrado en el hub.
LOCKATUS_REDIRECT_URI=

# --- Ecosistema (opcional) ---
# Destino del botón "Enviar a Escriba". Vacío → "/" (la propia app). Poné la URL de tu Escriba,
# ej. https://tu-escriba.com/  o un path interno si están en el mismo dominio (ej. /escriba).
ESCRIBA_URL=

# --- Modo estudio: guardar el trabajo (opcional) ---
# PERSISTENCIA=off (default) → no se guarda nada en el servidor: el documento se procesa en el
#   navegador y se descarta, como siempre.
# PERSISTENCIA=on → se guardan clientes, cuentas, meses, decisiones, papeles de trabajo y los
#   documentos (extractos y mayores). El procesamiento sigue en el navegador.
PERSISTENCIA=off
# Carpeta de datos (base SQLite; y los documentos si ALMACENAMIENTO=disco). Default: ./data al
# correr con Node; la imagen Docker usa /data. En Docker/EasyPanel montá un VOLUMEN en /data o se
# pierde al redeployar.
# DATA_DIR=/data
# Dónde van los documentos: disco (la carpeta de arriba) o s3 (Cloudflare R2, AWS S3, MinIO…).
ALMACENAMIENTO=disco
# Solo con ALMACENAMIENTO=s3:
#   R2:  S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   S3_REGION=auto
#   S3:  S3_ENDPOINT=https://s3.us-east-1.amazonaws.com              S3_REGION=us-east-1
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Prefijo opcional dentro del bucket (p. ej. "fulgoria" para compartir el bucket con otras apps).
S3_PREFIJO=
# Cifrado de los documentos ANTES de guardarlos (AES-256-GCM). Recomendado. Generala con:
#   openssl rand -hex 32
# GUARDALA BIEN: sin esta clave los documentos guardados no se pueden leer.
DOCS_CLAVE=
# Copia de la base cada N horas al mismo almacenamiento (backups/). 0 = desactivado.
BACKUP_HORAS=24
# Tamaño máximo de un documento subido, en MB.
DOC_MAX_MB=25

# --- Roles (modo estudio) ---
# Standalone: el usuario de arriba (AUTH_USER) es admin y da de alta al resto desde Conciliar →
# Usuarios (lector, preparador, revisor, admin). Federado: los roles vienen de Lockatus.
# on → quien preparó un mes no puede revisarlo (lo revisa otra persona).
REVISION_INDEPENDIENTE=off

# --- IA para bancos nuevos (opcional) ---
# Un admin puede configurarla desde Conciliar → IA (proveedor, modelo, clave): queda guardada en la
# base con la clave cifrada (hace falta DOCS_CLAVE) y manda sobre estas variables.
# Cuando un extracto no se lee bien, la IA propone las columnas. Al modelo llega solo un esqueleto
# anónimo (posiciones y tipos de celda; ni nombres, ni montos, ni cuentas) y la regla del saldo
# decide si la propuesta sirve. Vacío = sin IA.
#   anthropic → Claude (IA_MODELO por defecto: claude-opus-5-5; la clave puede ir en ANTHROPIC_API_KEY)
#   openai | gemini | openrouter → con IA_MODELO e IA_API_KEY
#   local → Ollama / LM Studio / vLLM (IA_URL, p. ej. http://ollama:11434/v1; sin clave)
IA_PROVEEDOR=
IA_MODELO=
IA_API_KEY=
IA_URL=
# Opcional (0 a 2). Vacía = no se manda. Si el modelo no la acepta (p. ej. los de razonamiento de
# OpenAI o los Claude actuales), se reintenta sin ella.
IA_TEMPERATURA=
# Consultas por persona y por hora (cada consulta cuesta).
IA_MAX_POR_HORA=30
